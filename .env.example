# Tracking Lab — environment variables
# Copy to .env and fill in. NEVER commit the filled .env.

# ─── Core (REQUIRED in production) ──────────────────────────────
# Flask session key. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=

# Postgres connection string (Supabase pooler recommended)
DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=require

# Production signal (set automatically on Render/Vercel). Forces the
# app to fail loudly if SECRET_KEY / CRON_SECRET / STRIPE_WEBHOOK_SECRET
# are missing. Leave unset in local dev.
# RENDER=1


# ─── Google OAuth ────────────────────────────────────────────────
# Leave empty to enable dev auto-login as dev@local.test
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin email (auto-promoted to admin on first login)
ADMIN_EMAIL=

# Comma-separated manager emails (see admin's data via data_user_id=1)
MANAGER_EMAILS=


# ─── Stripe billing ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# REQUIRED in prod — webhook rejects calls without this set
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly + annual price IDs per plan
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...


# ─── Transactional emails (Resend) ───────────────────────────────
# If RESEND_API_KEY is missing, emails silently no-op (app still works)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Tracking Lab
APP_BASE_URL=https://tracking-lab.io


# ─── Scraper tunables ────────────────────────────────────────────
SCRAPER_MAX_CONCURRENCY=20
SCRAPER_CACHE_TTL=300
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_BASE_BACKOFF=0.5
# Per-video YouTube detail fetch concurrency (v2)
SCRAPER_YT_DETAIL_CONCURRENCY=8
# Shared secret for Supabase edge function proxies (Instagram/LinkedIn)
SCRAPER_PROXY_SECRET=tracking-lab-2026


# ─── Cron / scheduled scrapes ────────────────────────────────────
# REQUIRED in prod — cron endpoints reject calls without correct Bearer
CRON_SECRET=
