{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/static/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape-tiktok-youtube",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scrape-instagram",
      "schedule": "30 12 * * *"
    }
  ]
}
